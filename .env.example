APP_NAME="Crystalline Dental PMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Damascus

# Clinic branding (used in email templates and UI)
APP_CLINIC_NAME="Crystalline Dental"
APP_CLINIC_PHONE=
APP_CLINIC_ADDRESS=
APP_CLINIC_PRIMARY_COLOR=#4fdbcc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dental_clinic_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# Queue — database driver for simplicity, switch to redis in production
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90

# Mail
# Use 'log' locally (outputs to laravel.log), 'smtp' in production
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourclinic.com"
MAIL_FROM_NAME="${APP_CLINIC_NAME}"

# For Mailgun (recommended for production):
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.yourclinic.com
# MAILGUN_SECRET=your-mailgun-api-key
# MAILGUN_ENDPOINT=api.mailgun.net

# Storage — local for dev, s3 for production
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1
SANCTUM_TOKEN_EXPIRATION=10080

# AI Integration
AI_PROVIDER=gemini
AI_API_KEY=
AI_VISION_MODEL=gemini-2.0-flash
AI_TEXT_MODEL=gemini-2.0-flash

# Redis (optional — use for queue/cache in production for better performance)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
